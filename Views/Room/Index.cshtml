@model List<otelrezervation.DTOs.RoomDto>
@{
    ViewData["Title"] = "Odalar";
}

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-door-open me-2" style="color: var(--gold);"></i>Oda Yönetimi</h2>
        <a asp-controller="Room" asp-action="Create" class="btn-gold">
            <i class="bi bi-plus-circle me-1"></i> Yeni Oda Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-luxury">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-luxury-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div style="text-align: center; padding: 60px 0; color: var(--text-light);">
            <i class="bi bi-building" style="font-size: 3rem; color: var(--gold); opacity: 0.4;"></i>
            <p class="mt-3">Sistemde henüz kayıtlı bir oda bulunmuyor.</p>
        </div>
    }
    else
    {
        <table class="luxury-table">
            <thead>
                <tr>
                    <th># ID</th>
                    <th>Oda Numarası</th>
                    <th>Gecelik Fiyat</th>
                    <th style="text-align: right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model)
                {
                    <tr>
                        <td style="color: var(--text-light);">#@room.Id</td>
                        <td style="color: var(--gold); font-weight: 600;">@room.OdaNumarasi</td>
                        <td>@room.GecelikFiyat.ToString("N0") ₺</td>
                        <td style="text-align: right;">
                            <a asp-controller="Room" asp-action="Edit" asp-route-id="@room.Id" class="btn-gold-outline" style="padding: 6px 16px; font-size: 0.7rem;">Düzenle</a>
                            <form asp-controller="Room" asp-action="Delete" asp-route-id="@room.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu odayı silmek istediğinize emin misiniz?');">
                                <button type="submit" style="background: transparent; border: 1px solid #ff6b6b; color: #ff6b6b; padding: 6px 16px; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; font-family: var(--font-body); cursor: pointer; font-weight: 600; transition: var(--transition);">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
