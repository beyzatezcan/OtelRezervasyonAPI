@model List<otelrezervation.DTOs.RoomDto>
@{
    ViewData["Title"] = "Oda Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-0 pt-4 pb-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-door-open me-2" style="color: #C2A676;"></i> Sistemdeki Odalar</h5>
            <div>
                <a asp-controller="Room" asp-action="Create" class="btn" style="background-color: #C2A676; color: #fff;">
                    <i class="bi bi-plus-circle me-1"></i> Yeni Oda Ekle
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="text-center" style="padding: 60px 0;">
                <i class="bi bi-building" style="font-size: 3rem; color: #C2A676; opacity: 0.4;"></i>
                <p class="mt-3 text-muted">Sistemde henüz kayıtlı bir oda bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th># ID</th>
                            <th>Görsel</th>
                            <th>Oda Numarası</th>
                            <th>Oda Tipi</th>
                            <th>Kapasite</th>
                            <th>Gecelik Fiyat</th>
                            <th style="text-align: right;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in Model)
                        {
                            <tr>
                                <td class="text-muted">#@room.Id</td>
                                <td>
                                    @{  // admin gorsel eklemese bile burda odaya uygun gorsel gozukur
                                        string displayImage = room.ImageUrls != null && room.ImageUrls.Count > 0 ? room.ImageUrls.First() : "";
                                        if (string.IsNullOrEmpty(displayImage))
                                        {
                                            switch (room.OdaTipi)
                                            {
                                                case "Standart": displayImage = "/images/room-ai-standard.png"; break;
                                                case "Lüks": displayImage = "/images/room-ai-deluxe.png"; break;
                                                case "Suit": displayImage = "/images/room-ai-suite.png"; break;
                                                case "Aile Odası": displayImage = "/images/room-ai-family.png"; break;
                                                case "Kral Dairesi": displayImage = "/images/room-ai-king.png"; break;
                                                default: displayImage = "/images/room-ai-standard.png"; break;
                                            }
                                        }
                                    }
                                    <img src="@displayImage" alt="Oda" style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #ccc;" />
                                </td>
                                <td><strong style="color: #C2A676;">@room.OdaNumarasi</strong></td>
                                <td>@room.OdaTipi</td>
                                <td>@room.Kapasite Kişi</td>
                                <td>@room.GecelikFiyat.ToString("N0") ₺</td>
                                <td style="text-align: right;">
                                    <a asp-controller="Room" asp-action="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                    <form asp-controller="Room" asp-action="Delete" asp-route-id="@room.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu odayı silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
