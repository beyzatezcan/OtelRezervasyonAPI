@model List<otelrezervation.DTOs.RoomDto>

@{
    ViewData["Title"] = "Odalar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Oda Listesi</h2>
        <a asp-controller="Room" asp-action="Create" class="btn btn-success">Yeni Oda Ekle</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info text-center" role="alert">
                    Sistemde henüz kayıtlı bir oda bulunmuyor.
                </div>
            }
            else
            {
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># ID</th>
                            <th>Oda Numarası</th>
                            <th>Gecelik Fiyat</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in Model)
                        {
                            <tr>
                                <td>@room.Id</td>
                                <td><span class="badge bg-secondary">@room.OdaNumarasi</span></td>
                                <td>@room.GecelikFiyat.ToString("C")</td>
                                <td class="text-center">
                                    <a asp-controller="Room" asp-action="Edit" asp-route-id="@room.Id" class="btn btn-sm btn-primary">Düzenle</a>
                                    
                                    <form asp-controller="Room" asp-action="Delete" asp-route-id="@room.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu odayı silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
