@model otelrezervation.DTOs.UpdateRoomDto
@{
    ViewData["Title"] = "Oda Düzenle";
}

<div class="luxury-form-container">
    <h3>Oda Düzenle</h3>
    <p class="form-subtitle">Oda bilgilerini güncelleyin</p>

    <form asp-controller="Room" asp-action="Edit" asp-route-id="@ViewBag.RoomId" method="post" class="luxury-form">
        <div class="mb-4">
            <label asp-for="OdaNumarasi" class="form-label">Oda Numarası</label>
            <input asp-for="OdaNumarasi" class="form-control" />
            <span asp-validation-for="OdaNumarasi" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="GecelikFiyat" class="form-label">Gecelik Fiyat (₺)</label>
            <input asp-for="GecelikFiyat" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="GecelikFiyat" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <button type="submit" class="btn-gold">Değişiklikleri Kaydet</button>
        <a asp-controller="Room" asp-action="Index" class="btn-gold-outline" style="width: 100%; text-align: center; margin-top: 10px; display: block;">İptal</a>
    </form>
</div>
