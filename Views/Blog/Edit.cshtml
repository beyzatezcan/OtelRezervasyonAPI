@model otelrezervation.Models.Blog
@{
    ViewData["Title"] = "Blog Yazısını Düzenle";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h4 style="color: var(--gold); font-family: 'Playfair Display', serif;"><i class="bi bi-pencil-square me-2"></i>Blog Yazısını Düzenle</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="OlusturulmaTarihi" />

                    <div class="mb-3">
                        <label asp-for="Baslik" class="form-label fw-bold">Başlık</label>
                        <input asp-for="Baslik" class="form-control form-control-lg" />
                        <span asp-validation-for="Baslik" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ResimUrl" class="form-label fw-bold">Kapak Görseli URL (Opsiyonel)</label>
                        <input asp-for="ResimUrl" class="form-control" />
                        <span asp-validation-for="ResimUrl" class="text-danger small"></span>
                        @if (!string.IsNullOrEmpty(Model.ResimUrl))
                        {
                            <div class="mt-2">
                                <img src="@Model.ResimUrl" alt="Mevcut Kapak" class="img-thumbnail" style="max-height: 100px; object-fit: cover;" />
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Icerik" class="form-label fw-bold">İçerik</label>
                        <textarea asp-for="Icerik" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Icerik" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="AdminIndex" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-gold px-4">
                            <i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
