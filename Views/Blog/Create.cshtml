@model otelrezervation.Models.Blog
@{
    ViewData["Title"] = "Yeni Blog Yazısı";
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h4 style="color: var(--gold); font-family: 'Playfair Display', serif;"><i class="bi bi-journal-plus me-2"></i>Yeni Blog Ekle</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Baslik" class="form-label fw-bold">Başlık</label>
                        <input asp-for="Baslik" class="form-control form-control-lg" placeholder="Örn: Otelimizde Yeni Sezon Heyecanı" />
                        <span asp-validation-for="Baslik" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ResimUrl" class="form-label fw-bold">Kapak Görseli URL (Opsiyonel)</label>
                        <input asp-for="ResimUrl" class="form-control" placeholder="https://ornek.com/resim.jpg" />
                        <span asp-validation-for="ResimUrl" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Icerik" class="form-label fw-bold">İçerik</label>
                        <textarea asp-for="Icerik" class="form-control" rows="8" placeholder="Blog yazınızın içeriğini buraya girin..."></textarea>
                        <span asp-validation-for="Icerik" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="AdminIndex" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> İptal ve Geri Dön
                        </a>
                        <button type="submit" class="btn btn-gold px-4">
                            <i class="bi bi-check-circle me-1"></i> Kaydet ve Yayınla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
