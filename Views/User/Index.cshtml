@model List<otelrezervation.DTOs.UserDto>
@{
    ViewData["Title"] = "Müşteri Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-0 pt-4 pb-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2" style="color: #C2A676;"></i> Sistemdeki Müşteriler</h5>
            <a asp-action="Create" class="btn" style="background-color: #C2A676; color: #fff;">
                <i class="bi bi-person-plus me-1"></i> Yeni Müşteri Ekle
            </a>
        </div>
    </div>
    <div class="card-body">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="text-center" style="padding: 60px 0;">
                <i class="bi bi-person-x" style="font-size: 3rem; color: #C2A676; opacity: 0.4;"></i>
                <p class="mt-3 text-muted">Sistemde henüz kayıtlı bir müşteri bulunmuyor.</p>
            </div>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ad</th>
                            <th>Soyad</th>
                            <th>E-Posta</th>
                            <th>Telefon</th>
                            <th style="text-align: right;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="text-muted">#@user.Id</td>
                                <td>@user.Ad</td>
                                <td>@user.Soyad</td>
                                <td><strong style="color: #C2A676;">@user.Email</strong></td>
                                <td>@user.Telefon</td>
                                <td style="text-align: right;">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu müşteriyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
