@model List<otelrezervation.DTOs.UserDto>

@{
    ViewData["Title"] = "Müşteriler";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Müşteri Listesi</h2>
        <a asp-action="Create" class="btn btn-success">Yeni Müşteri Ekle</a>
    </div>

    <!-- YENİ: Hata veya Başarı mesajlarını ekranda göstermek için -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info text-center" role="alert">
                    Sistemde henüz kayıtlı bir müşteri bulunmuyor.
                </div>
            }
            else
            {
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Ad</th>
                            <th>Soyad</th>
                            <th>E-Posta</th>
                            <th>Telefon</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.Ad</td>
                                <td>@user.Soyad</td>
                                <td>@user.Email</td>
                                <td>@user.Telefon</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-primary">Düzenle</a>
                                    
                                    <!-- YENİ: Silme butonu Controller'a POST atıyor -->
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu müşteriyi silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
