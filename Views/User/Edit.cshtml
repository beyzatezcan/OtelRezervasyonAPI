@model otelrezervation.DTOs.UpdateUserDto
@{
    ViewData["Title"] = "Müşteri Düzenle";
}

<div class="luxury-form-container" style="max-width: 520px;">
    <h3>Müşteri Düzenle</h3>
    <p class="form-subtitle">Müşteri bilgilerini güncelleyin</p>

    <form asp-action="Edit" asp-route-id="@ViewBag.UserId" method="post" class="luxury-form">
        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="Ad" class="form-label">Ad</label>
                <input asp-for="Ad" class="form-control" />
                <span asp-validation-for="Ad" style="color: #ff6b6b; font-size: 0.8rem;"></span>
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="Soyad" class="form-label">Soyad</label>
                <input asp-for="Soyad" class="form-control" />
                <span asp-validation-for="Soyad" style="color: #ff6b6b; font-size: 0.8rem;"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label">E-Posta</label>
            <input asp-for="Email" type="email" class="form-control" />
            <span asp-validation-for="Email" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Telefon" class="form-label">Telefon Numarası</label>
            <input asp-for="Telefon" class="form-control" />
            <span asp-validation-for="Telefon" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <button type="submit" class="btn-gold">Değişiklikleri Kaydet</button>
        <a href="/User/Index" class="btn-gold-outline" style="width: 100%; text-align: center; margin-top: 10px; display: block;">İptal</a>
    </form>
</div>
