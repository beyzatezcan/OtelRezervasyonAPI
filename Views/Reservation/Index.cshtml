@model IEnumerable<otelrezervation.DTOs.ReservationDto>
@{
    ViewData["Title"] = "Rezervasyon Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-0 pt-4 pb-3">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-calendar-check me-2" style="color: #C2A676;"></i> Tüm Rezervasyonlar</h5>
            <a asp-action="Create" class="btn" style="background-color: #C2A676; color: #fff;">
                <i class="bi bi-plus-circle me-1"></i> Manuel Rezervasyon
            </a>
        </div>
    </div>
    <div class="card-body">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive mt-3">
                <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Oda No</th>
                    <th>Müşteri</th>
                    <th>Giriş Tarihi</th>
                    <th>Çıkış Tarihi</th>
                    <th>Durum</th>
                    <th>Özel İstekler</th>
                    <th style="text-align: right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in Model)
                {
                    <tr>
                        <td style="color: var(--text-light);">#@res.Id</td>
                        <td style="color: var(--gold); font-weight: 600;">@res.OdaNumarasi</td>
                        <td>@res.MusteriAdi</td>
                        <td>
                            <span style="background: rgba(76, 175, 80, 0.15); color: #66bb6a; padding: 4px 12px; font-size: 0.8rem; font-weight: 600;">
                                @res.GirisTarihi.ToString("dd.MM.yyyy")
                            </span>
                        </td>
                        <td>
                            <span style="background: rgba(220, 53, 69, 0.15); color: #ff6b6b; padding: 4px 12px; font-size: 0.8rem; font-weight: 600;">
                                @res.CikisTarihi.ToString("dd.MM.yyyy")
                            </span>
                        </td>
                        <td>
                            @if (res.Status == otelrezervation.Models.ReservationStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                            }
                            else if (res.Status == otelrezervation.Models.ReservationStatus.CheckedIn)
                            {
                                <span class="badge bg-primary">Giriş Yapıldı</span>
                            }
                            else if (res.Status == otelrezervation.Models.ReservationStatus.CheckedOut)
                            {
                                <span class="badge bg-success">Çıkış Yapıldı</span>
                            }
                            else if (res.Status == otelrezervation.Models.ReservationStatus.Cancelled)
                            {
                                <span class="badge bg-danger">İptal Edildi</span>
                            }
                        </td>
                        <td style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@res.OzelIstekler">
                            @(string.IsNullOrEmpty(res.OzelIstekler) ? "-" : res.OzelIstekler)
                        </td>
                        <td style="text-align: right;">
                            <div class="d-flex justify-content-end gap-2">
                                @if (res.Status == otelrezervation.Models.ReservationStatus.Pending)
                                {
                                    bool canCheckIn = DateTime.Today >= res.GirisTarihi.Date;
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@res.Id" />
                                        <input type="hidden" name="status" value="CheckedIn" />
                                        @if(canCheckIn)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-primary" style="font-size:0.75rem;">Check-in</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem;" title="Giriş tarihi henüz gelmediği için Check-in yapılamaz." disabled>Check-in</button>
                                        }
                                    </form>
                                }
                                else if (res.Status == otelrezervation.Models.ReservationStatus.CheckedIn)
                                {
                                    <form asp-action="UpdateStatus" method="post">
                                        <input type="hidden" name="id" value="@res.Id" />
                                        <input type="hidden" name="status" value="CheckedOut" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" style="font-size:0.75rem;">Check-out</button>
                                    </form>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Delete" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="font-size: 0.75rem;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center" style="padding: 60px 0;">
                <i class="bi bi-inbox" style="font-size: 3rem; color: #C2A676; opacity: 0.4;"></i>
                <p class="mt-3 text-muted">Sistemde kayıtlı hiçbir rezervasyon bulunmuyor.</p>
            </div>
        }
    </div>
</div>
    }

