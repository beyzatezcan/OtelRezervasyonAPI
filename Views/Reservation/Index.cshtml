@model List<otelrezervation.DTOs.ReservationDto>

@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Rezervasyon Listesi</h2>
        <a asp-controller="Reservation" asp-action="Create" class="btn btn-success">Yeni Rezervasyon Al</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info text-center" role="alert">
                    Sistemde henüz kayıtlı bir rezervasyon bulunmuyor.
                </div>
            }
            else
            {
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th># Kayıt No</th>
                            <th>Müşteri Adı</th>
                            <th>Oda Numarası</th>
                            <th>Giriş Tarihi</th>
                            <th>Çıkış Tarihi</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td>@res.Id</td>
                                <td class="fw-bold">@res.MusteriAdi</td>
                                <td><span class="badge bg-secondary">@res.OdaNumarasi</span></td>
                                <td>@res.GirisTarihi.ToShortDateString()</td>
                                <td>@res.CikisTarihi.ToShortDateString()</td>
                                <td class="text-center">
                                    <form asp-controller="Reservation" asp-action="Delete" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Bu rezervasyonu İPTAL etmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-danger">İptal Et</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
