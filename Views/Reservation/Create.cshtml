@model otelrezervation.DTOs.CreateReservationDto
@{
    ViewData["Title"] = "Yeni Rezervasyon";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-calendar-plus"></i> Yeni Rezervasyon Al</h4>
            </div>
            <div class="card-body">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    
                    <div class="mb-3">
                        <label asp-for="UserId" class="form-label fw-bold">Müşteri Seçin</label>
                        <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                            <option value="">-- Müşteri Seç --</option>
                        </select>
                        <span asp-validation-for="UserId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="RoomId" class="form-label fw-bold">Oda Seçin</label>
                        <select asp-for="RoomId" class="form-select" asp-items="ViewBag.Rooms">
                            <option value="">-- Oda Seç --</option>
                        </select>
                        <span asp-validation-for="RoomId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GirisTarihi" class="form-label fw-bold">Giriş Tarihi</label>
                        <input asp-for="GirisTarihi" type="date" class="form-control" />
                        <span asp-validation-for="GirisTarihi" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CikisTarihi" class="form-label fw-bold">Çıkış Tarihi</label>
                        <input asp-for="CikisTarihi" type="date" class="form-control" />
                        <span asp-validation-for="CikisTarihi" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                        <button type="submit" class="btn btn-success">Kaydet</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
