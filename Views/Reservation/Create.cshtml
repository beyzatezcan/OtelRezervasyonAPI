@model otelrezervation.DTOs.CreateReservationDto
@{
    ViewData["Title"] = "Manuel Rezervasyon";
}

<div class="luxury-form-container" style="max-width: 640px;">
    <h3>Manuel Rezervasyon</h3>
    <p class="form-subtitle">Müşteri adına yeni bir rezervasyon oluşturun</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-luxury-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="Create" method="post" class="luxury-form">
        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="UserId" class="form-label">Müşteri Seçin</label>
                <select asp-for="UserId" class="form-select">
                    <option value="">-- Müşteri Seçiniz --</option>
                    @if(ViewBag.Users != null)
                    {
                        foreach(var u in ViewBag.Users)
                        {
                            <option value="@u.Id">@u.Ad @u.Soyad (@u.Email)</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-6 mb-4">
                <label asp-for="RoomId" class="form-label">Oda Seçin</label>
                <select asp-for="RoomId" class="form-select" id="RoomId">
                    <option value="">-- Oda Seçiniz --</option>
                    @if(ViewBag.Rooms != null)
                    {
                        foreach(var r in ViewBag.Rooms)
                        {
                            <option value="@r.Id">Oda @r.OdaNumarasi — @r.GecelikFiyat.ToString("N0") ₺</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="GirisTarihi" class="form-label">Giriş Tarihi</label>
                <input asp-for="GirisTarihi" type="text" class="form-control" placeholder="Tarih seçin..." />
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="CikisTarihi" class="form-label">Çıkış Tarihi</label>
                <input asp-for="CikisTarihi" type="text" class="form-control" placeholder="Tarih seçin..." />
            </div>
        </div>

        <button type="submit" class="btn-gold"><i class="bi bi-save me-2"></i>Rezervasyonu Kaydet</button>
        <a asp-action="Index" class="btn-gold-outline" style="width: 100%; text-align: center; margin-top: 10px; display: block;">İptal</a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var tumTarihler = @Html.Raw(string.IsNullOrEmpty(ViewBag.TumDoluTarihler) ? "[]" : ViewBag.TumDoluTarihler);
            if (!Array.isArray(tumTarihler)) { tumTarihler = []; }

            var fpOptions = {
                locale: "tr",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d F Y",
                minDate: "today"
            };

            var girisFp = flatpickr("#GirisTarihi", fpOptions);
            var cikisFp = flatpickr("#CikisTarihi", fpOptions);

            var roomSelect = document.getElementById("RoomId");

            function guncelleTakvim() {
                var seciliOda = parseInt(roomSelect.value);
                if (!seciliOda) {
                    girisFp.set("disable", []);
                    cikisFp.set("disable", []);
                    return;
                }
                var disableDates = [];
                tumTarihler.forEach(function(item) {
                    if (item.RoomId === seciliOda && item.Giris && item.Cikis) {
                        disableDates.push({ from: item.Giris.split('T')[0], to: item.Cikis.split('T')[0] });
                    }
                });
                girisFp.set("disable", disableDates);
                cikisFp.set("disable", disableDates);
            }

            roomSelect.addEventListener("change", guncelleTakvim);
            guncelleTakvim();
        });
    </script>
}
