@model List<otelrezervation.Models.SiteSetting>

@{
    ViewData["Title"] = "İletişim (Düzenleme Modu)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    string GetVal(string key, string defaultVal) {
        var setting = Model.FirstOrDefault(s => s.Key == key);
        return setting?.Value ?? defaultVal;
    }
}

<!-- Frontend CSS for accurate preview -->
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h4><i class="bi bi-envelope text-info"></i> İletişim Sayfası (Görsel Düzenleyici)</h4>
    <div>
        <button class="btn btn-primary" onclick="saveAllChanges()"><i class="bi bi-save"></i> Tüm Değişiklikleri Kaydet</button>
        <a href="/SiteSettings/PageManager" class="btn btn-secondary">İptal</a>
    </div>
</div>

<div class="visual-editor-container border rounded bg-white shadow-sm" style="overflow: hidden; pointer-events: auto;">
    
    <!-- ========== HERO SECTION PREVIEW & EDIT ========== -->
    <div class="position-relative">
        <div class="position-absolute top-0 end-0 m-3 z-3">
            <button class="btn btn-dark btn-sm shadow" data-bs-toggle="modal" data-bs-target="#imageModal_ContactHeroImage">
                <i class="bi bi-image"></i> Arka Planı Değiştir
            </button>
        </div>

        <section class="hero-section" style="background-image: linear-gradient(rgba(10, 10, 10, 0.7), rgba(10, 10, 10, 0.7)), url('@GetVal("ContactHeroImage", "/images/room-suite.png")'); height: 60vh;">
            <div class="hero-content" style="padding-top: 15vh;">
                <div class="hero-subtitle editable-inline" data-key="ContactHeroSubtitle">@Html.Raw(GetVal("ContactHeroSubtitle", "Bize Ulaşın"))</div>
                <h1 style="font-size: 3rem;" class="editable-inline" data-key="ContactHeroTitle">@Html.Raw(GetVal("ContactHeroTitle", "Lumina İletişim"))</h1>
                <div class="divider mx-auto mt-4"></div>
            </div>
        </section>
    </div>

    <!-- ========== CONTACT SECTION PREVIEW & EDIT ========== -->
    <section class="section" style="background: var(--dark);">
        <div class="container">
            <div class="row align-items-center">
                
                <div class="col-lg-5 mb-5 mb-lg-0">
                    <div style="padding-right: 50px;">
                        <span class="overline">İletişim Bilgileri</span>
                        <div class="editable-inline" data-key="ContactSectionTitle" style="color: var(--white); font-family: var(--font-heading); font-size: 2.5rem; margin-bottom: 30px;">
                            @Html.Raw(GetVal("ContactSectionTitle", "Sorularınız için<br/>buradayız"))
                        </div>
                        <div class="editable-block" data-key="ContactSectionDesc" style="color: var(--text-light); margin-bottom: 40px; font-size: 1.1rem;">
                            @Html.Raw(GetVal("ContactSectionDesc", "Unutulmaz tatilinizle ilgili her türlü soru, görüş ve öneriniz için bizimle iletişime geçebilirsiniz. Müşteri temsilcilerimiz en kısa sürede size geri dönüş yapacaktır."))
                        </div>
                        
                        <div class="alert alert-secondary text-dark mt-4" role="alert" style="border: 1px dashed #6c757d; font-size: 0.9rem;">
                            <i class="bi bi-info-circle me-2"></i> <strong>Bilgi:</strong> Adres, Telefon ve E-posta bilgilerini bu ekrandan değil, <strong>Yönetim Paneli > Site Ayarları (Ortak Alanlar)</strong> menüsünden güncelleyebilirsiniz.
                        </div>
                    </div>
                </div>
                
                <!-- CONTACT FORM (Read Only Preview) -->
                <div class="col-lg-7">
                    <div class="luxury-form-container" style="background: var(--dark-card); border: 1px solid rgba(194,166,118,0.2); max-width: 100%; box-shadow: 0 20px 40px rgba(0,0,0,0.4); pointer-events: none; opacity: 0.8;">
                        <h3 style="margin-bottom: 5px;">Mesaj Gönder</h3>
                        <p class="form-subtitle">Tüm alanları doldurarak bize ulaşın</p>
                        
                        <form class="luxury-form">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label class="form-label">Adınız Soyadınız</label>
                                    <input type="text" class="form-control" placeholder="Ad Soyad" />
                                </div>
                                <div class="col-md-6 mb-4">
                                    <label class="form-label">E-Posta Adresiniz</label>
                                    <input type="text" class="form-control" placeholder="ornek@email.com" />
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label">Mesajınız</label>
                                <textarea class="form-control" rows="5" placeholder="Bize nasıl yardımcı olabiliriz?"></textarea>
                            </div>
                            <button type="button" class="btn-gold" style="width: 100%;">
                                <i class="bi bi-send me-2"></i> Mesajı Gönder
                            </button>
                        </form>
                    </div>
                </div>
                
            </div>
        </div>
    </section>
</div>

<!-- Modal for ContactHeroImage -->
<div class="modal fade" id="imageModal_ContactHeroImage" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">İletişim Kapak Resmini Değiştir</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form asp-action="UpdateImage" method="post" enctype="multipart/form-data">
          <div class="modal-body">
              <input type="hidden" name="key" value="ContactHeroImage" />
              <input type="hidden" name="pageName" value="Contact" />
              <input type="file" name="imageFile" class="form-control" accept="image/*" required />
          </div>
          <div class="modal-footer">
              <button type="submit" class="btn btn-primary">Yükle ve Değiştir</button>
          </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
    <script src="https://cdn.ckeditor.com/ckeditor5/40.0.0/inline/ckeditor.js"></script>
    <style>
        .editable-inline, .editable-block { border: 1px dashed transparent; transition: all 0.3s; position: relative; }
        .editable-inline:hover, .editable-block:hover { border-color: #28a745; background-color: rgba(40, 167, 69, 0.05); cursor: pointer; }
        .editable-inline::after, .editable-block::after { content: "\F4CB"; font-family: bootstrap-icons; position: absolute; top: -15px; right: -15px; background: #28a745; color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; opacity: 0; transition: opacity 0.3s; }
        .editable-inline:hover::after, .editable-block:hover::after { opacity: 1; }
        .ck-editor__editable_inline { border: 1px dashed #c2a676 !important; background-color: rgba(0, 0, 0, 0.2) !important; color: white !important; padding: 10px; }
    </style>
    <script>
        const editors = {};
        document.querySelectorAll('.editable-inline, .editable-block').forEach(element => {
            InlineEditor
                .create(element, { toolbar: ['bold', 'italic', 'link'] })
                .then(editor => { editors[element.getAttribute('data-key')] = editor; })
                .catch(error => { console.error(error); });
        });

        function saveAllChanges() {
            let promises = [];
            let btn = document.querySelector('.btn-primary');
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Kaydediliyor...';
            
            Object.keys(editors).forEach(key => {
                let value = editors[key].getData();
                let formData = new FormData();
                formData.append('key', key);
                formData.append('value', value);
                formData.append('pageName', 'Contact');
                let p = fetch('/SiteSettings/UpdateText', { method: 'POST', body: formData });
                promises.push(p);
            });
            
            Promise.all(promises).then(() => {
                alert("Tüm değişiklikler başarıyla kaydedildi!");
                window.location.reload();
            }).catch(err => {
                alert("Kaydetme sırasında bir hata oluştu.");
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-save"></i> Tüm Değişiklikleri Kaydet';
            });
        }
    </script>
}
