@{
    ViewData["Title"] = "Sayfa Yönetimi (CMS)";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>İçerik Yönetimi (Hangi sayfayı düzenlemek istersiniz?)</h2>
</div>

<div class="row g-4 mt-2">
    <!-- Ana Sayfa Kutu -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center" style="transition: transform 0.3s;">
            <div class="card-body py-5">
                <i class="bi bi-house-door" style="font-size: 3rem; color: var(--gold);"></i>
                <h4 class="mt-3">Ana Sayfa</h4>
                <p class="text-muted small">Ana sayfa kapak resimleri, vitrin yazıları ve karşılama metinleri.</p>
                <a href="/SiteSettings/EditPage?page=Home" class="btn btn-primary mt-3">Sayfayı Düzenle</a>
            </div>
        </div>
    </div>

    <!-- Hakkımızda Kutu -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center" style="transition: transform 0.3s;">
            <div class="card-body py-5">
                <i class="bi bi-info-circle" style="font-size: 3rem; color: var(--gold);"></i>
                <h4 class="mt-3">Hakkımızda</h4>
                <p class="text-muted small">Otelin tarihçesi, misyonu, vizyonu ve kurumsal fotoğrafları.</p>
                <a href="/SiteSettings/EditPage?page=About" class="btn btn-primary mt-3">Sayfayı Düzenle</a>
            </div>
        </div>
    </div>

    <!-- Odalar Kutu -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center" style="transition: transform 0.3s;">
            <div class="card-body py-5">
                <i class="bi bi-door-open" style="font-size: 3rem; color: var(--gold);"></i>
                <h4 class="mt-3">Odalar Vitrini</h4>
                <p class="text-muted small">Oda listeleme sayfasının genel tanıtım metinleri ve üst görselleri.</p>
                <a href="/SiteSettings/EditPage?page=Rooms" class="btn btn-primary mt-3">Sayfayı Düzenle</a>
            </div>
        </div>
    </div>

    <!-- İletişim Kutu -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center" style="transition: transform 0.3s;">
            <div class="card-body py-5">
                <i class="bi bi-telephone" style="font-size: 3rem; color: var(--gold);"></i>
                <h4 class="mt-3">İletişim</h4>
                <p class="text-muted small">İletişim sayfası kapak resmi ve tanıtım yazıları.</p>
                <a href="/SiteSettings/EditPage?page=Contact" class="btn btn-primary mt-3">Sayfayı Düzenle</a>
            </div>
        </div>
    </div>

    <!-- Haberler (Blog) Kutu -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center" style="transition: transform 0.3s;">
            <div class="card-body py-5">
                <i class="bi bi-journal-text" style="font-size: 3rem; color: #28a745;"></i>
                <h4 class="mt-3">Haberler (Blog)</h4>
                <p class="text-muted small">Sınırsız sayıda blog, duyuru ve etkinlik ekleyip çıkarabilirsiniz.</p>
                <a href="/Blog/AdminIndex" class="btn btn-success mt-3">Haberleri Yönet</a>
            </div>
        </div>
    </div>

    <!-- Ortak Alanlar Kutu -->
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 text-center" style="transition: transform 0.3s;">
            <div class="card-body py-5">
                <i class="bi bi-layout-text-window-reverse" style="font-size: 3rem; color: #6c757d;"></i>
                <h4 class="mt-3">Ortak Alanlar</h4>
                <p class="text-muted small">Tüm sitelerde (sayfalarda) ortak olarak bulunan iletişim bilgileri ve alt bilgi (footer) metinleri.</p>
                <a href="/SiteSettings/Index" class="btn btn-secondary mt-3">Ortak Alanları Yönet</a>
            </div>
        </div>
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
