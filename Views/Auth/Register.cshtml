@model otelrezervation.DTOs.CreateUserDto
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="luxury-form-container" style="max-width: 520px;">
    <h3>Hesap Oluşturun</h3>
    <p class="form-subtitle">Odalarımızı keşfetmek ve rezervasyon yapmak için kayıt olun</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-luxury-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="Register" method="post" class="luxury-form">
        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="Ad" class="form-label">Adınız</label>
                <input asp-for="Ad" class="form-control" placeholder="Adınız" />
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="Soyad" class="form-label">Soyadınız</label>
                <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label">E-Posta</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="ornek@email.com" />
        </div>

        <div class="mb-4">
            <label asp-for="Telefon" class="form-label">Telefon</label>
            <input asp-for="Telefon" type="tel" class="form-control" placeholder="5xx xxx xx xx" />
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Şifre</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="••••••" />
        </div>

        <button type="submit" class="btn-gold">Kayıt Ol</button>

        <div class="text-center mt-4">
            <span style="color: var(--text-light); font-size: 0.85rem;">Zaten üye misiniz?</span>
            <a href="/Auth/Login" style="color: var(--gold); font-weight: 600; font-size: 0.85rem; margin-left: 4px;">Giriş Yap</a>
        </div>
    </form>
</div>
