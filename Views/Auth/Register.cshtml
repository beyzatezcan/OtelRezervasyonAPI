@model otelrezervation.DTOs.CreateUserDto
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = null; 
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - Otel Portalı</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow-sm p-4" style="width: 100%; max-width: 450px;">
        <div class="text-center mb-4">
            <h3 class="text-primary fw-bold">Yeni Müşteri Kaydı</h3>
            <p class="text-muted">Hemen kayıt olun ve odalarımızı inceleyin!</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger p-2">
                <div asp-validation-summary="All" class="text-danger mb-0" style="font-size: 0.9rem;"></div>
            </div>
        }

        <form asp-action="Register" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Ad" class="form-label fw-bold">Adınız</label>
                    <input asp-for="Ad" class="form-control" placeholder="Adınız" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Soyad" class="form-label fw-bold">Soyadınız</label>
                    <input asp-for="Soyad" class="form-control" placeholder="Soyadınız" />
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-bold">E-Posta</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@mail.com" />
            </div>
            
            <div class="mb-3">
                <label asp-for="Telefon" class="form-label fw-bold">Telefon</label>
                <input asp-for="Telefon" type="tel" class="form-control" placeholder="5xx xxx xx xx" />
            </div>
            
            <div class="mb-4">
                <label asp-for="Password" class="form-label fw-bold">Şifre</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Gizli Şifreniz" />
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold">Kayıt Ol</button>
            <div class="text-center mt-3">
                <span class="text-muted">Zaten üye misiniz?</span>
                <a href="/Auth/Login" class="text-decoration-none fw-bold">Giriş Yap</a>
            </div>
        </form>
    </div>

</body>
</html>
