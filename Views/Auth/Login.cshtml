@model otelrezervation.DTOs.LoginDto
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="luxury-form-container">
    <h3>Hoşgeldiniz</h3>
    <p class="form-subtitle">Hesabınıza giriş yapın</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-luxury-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-controller="Auth" asp-action="Login" method="post" class="luxury-form">
        <div class="mb-4">
            <label asp-for="Email" class="form-label">E-Posta Adresi</label>
            <input asp-for="Email" class="form-control" placeholder="ornek@email.com" />
        </div>

        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <label asp-for="Password" class="form-label mb-0">Şifre</label>
                <a asp-controller="Auth" asp-action="ForgotPassword" style="color: var(--gold); font-size: 0.75rem; text-decoration: none;">Şifremi Unuttum</a>
            </div>
            <input asp-for="Password" type="password" class="form-control mt-2" placeholder="••••••" />
        </div>

        <button type="submit" class="btn-gold">Giriş Yap</button>

        <div class="text-center mt-4">
            <span style="color: var(--text-light); font-size: 0.85rem;">Hesabınız yok mu?</span>
            <a href="/Auth/Register" style="color: var(--gold); font-weight: 600; font-size: 0.85rem; margin-left: 4px;">Kayıt Ol</a>
        </div>
    </form>
</div>
