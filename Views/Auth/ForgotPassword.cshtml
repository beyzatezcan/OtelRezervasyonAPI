@model otelrezervation.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="luxury-form-container" style="max-width: 450px; margin: 60px auto;">
    <h3 class="text-center" style="font-family: 'Playfair Display', serif; color: var(--gold);">Şifremi Unuttum</h3>
    <p class="form-subtitle text-center">E-posta adresinizi girerek şifre sıfırlama bağlantısı alabilirsiniz.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="font-size: 0.85rem;">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="luxury-form">
        <div class="mb-4">
            <label asp-for="Email" class="form-label">Kayıtlı E-posta Adresiniz</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="ornek@email.com" />
            <span asp-validation-for="Email" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <button type="submit" class="btn-gold"><i class="bi bi-envelope me-2"></i>Sıfırlama Bağlantısı Gönder</button>
        
        <div class="text-center mt-3">
            <a asp-action="Login" style="color: var(--text-light); text-decoration: none; font-size: 0.85rem;"><i class="bi bi-arrow-left me-1"></i> Giriş Sayfasına Dön</a>
        </div>
    </form>
</div>
