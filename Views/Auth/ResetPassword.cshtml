@model otelrezervation.DTOs.ResetPasswordDto
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
}

<div class="luxury-form-container" style="max-width: 450px; margin: 60px auto;">
    <h3 class="text-center" style="font-family: 'Playfair Display', serif; color: var(--gold);">Yeni Şifre Belirle</h3>
    <p class="form-subtitle text-center">Lütfen yeni şifrenizi giriniz.</p>

    <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="luxury-form">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-4">
            <label asp-for="NewPassword" class="form-label">Yeni Şifre</label>
            <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="NewPassword" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrar</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
            <span asp-validation-for="ConfirmPassword" style="color: #ff6b6b; font-size: 0.8rem;"></span>
        </div>

        <button type="submit" class="btn-gold"><i class="bi bi-key me-2"></i>Şifremi Güncelle</button>
    </form>
</div>
