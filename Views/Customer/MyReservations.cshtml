@model IEnumerable<otelrezervation.Models.Reservation>
@{
    ViewData["Title"] = "Benim Rezervasyonlarım";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold">Benim Rezervasyonlarım</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary shadow-sm"><i class="bi bi-door-open me-2"></i>Yeni Oda Bul</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success shadow-sm">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Oda No</th>
                            <th>Tarih Aralığı</th>
                            <th>Fiyat (Gece)</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@(res.Room != null ? res.Room.OdaNumarasi : "-")</td>
                                <td>
                                    <span class="badge bg-primary text-white">@res.GirisTarihi.ToString("dd.MM.yyyy")</span>
                                    <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                    <span class="badge bg-danger text-white">@res.CikisTarihi.ToString("dd.MM.yyyy")</span>
                                </td>
                                <td class="text-success fw-bold">@(res.Room != null ? res.Room.GecelikFiyat.ToString("C") : "-")</td>
                                <td class="text-end pe-4">
                                    <form asp-action="CancelReservation" asp-route-id="@res.Id" method="post" class="d-inline" onsubmit="return confirm('Bu rezervasyonunuzu iptal etmek istediğinize emin misiniz?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle me-1"></i>İptal Et</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-calendar-x display-4 mb-3 d-block"></i>
                <h5>Henüz bir rezervasyonunuz bulunmuyor.</h5>
                <p>Otelimizin harika odalarını keşfetmek için hemen ana sayfaya dönün!</p>
            </div>
        }
    </div>
</div>
