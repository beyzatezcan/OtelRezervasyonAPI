@model IEnumerable<otelrezervation.Models.Reservation>
@{
    ViewData["Title"] = "Rezervasyonlarım";
}

<div class="admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-heart me-2" style="color: var(--gold);"></i>Rezervasyonlarım</h2>
        <a asp-controller="Home" asp-action="Index" class="btn-gold">
            <i class="bi bi-door-open me-1"></i> Yeni Oda Bul
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-luxury">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-luxury-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="luxury-table">
            <thead>
                <tr>
                    <th>Oda No</th>
                    <th>Tarih Aralığı</th>
                    <th>Gecelik Fiyat</th>
                    <th style="text-align: right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in Model)
                {
                    <tr>
                        <td style="color: var(--gold); font-weight: 600;">@(res.Room != null ? res.Room.OdaNumarasi : "-")</td>
                        <td>
                            <span style="background: rgba(76, 175, 80, 0.15); color: #66bb6a; padding: 4px 12px; font-size: 0.8rem; font-weight: 600;">
                                @res.GirisTarihi.ToString("dd.MM.yyyy")
                            </span>
                            <i class="bi bi-arrow-right mx-2" style="color: var(--text-light);"></i>
                            <span style="background: rgba(220, 53, 69, 0.15); color: #ff6b6b; padding: 4px 12px; font-size: 0.8rem; font-weight: 600;">
                                @res.CikisTarihi.ToString("dd.MM.yyyy")
                            </span>
                        </td>
                        <td style="color: var(--gold);">@(res.Room != null ? res.Room.GecelikFiyat.ToString("N0") + " ₺" : "-")</td>
                        <td style="text-align: right;">
                            <form asp-action="CancelReservation" asp-route-id="@res.Id" method="post" class="d-inline" onsubmit="return confirm('Bu rezervasyonunuzu iptal etmek istediğinize emin misiniz?');">
                                <button type="submit" style="background: transparent; border: 1px solid #ff6b6b; color: #ff6b6b; padding: 6px 16px; font-size: 0.7rem; letter-spacing: 1px; text-transform: uppercase; font-family: var(--font-body); cursor: pointer; font-weight: 600;">
                                    <i class="bi bi-x-circle me-1"></i> İptal Et
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div style="text-align: center; padding: 60px 0; color: var(--text-light);">
            <i class="bi bi-calendar-x" style="font-size: 3rem; color: var(--gold); opacity: 0.4;"></i>
            <h5 class="mt-3" style="color: var(--white);">Henüz bir rezervasyonunuz bulunmuyor.</h5>
            <p>Otelimizin harika odalarını keşfetmek için hemen ana sayfaya dönün!</p>
        </div>
    }
</div>
