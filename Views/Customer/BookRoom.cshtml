@model otelrezervation.DTOs.CreateReservationDto
@{
    ViewData["Title"] = "Rezervasyon Yap";
}

<div class="luxury-form-container" style="max-width: 640px;">
    <h3>Rezervasyon Yap</h3>
    <p class="form-subtitle">Seçtiğiniz oda için tarihleri belirleyin</p>

    <div class="alert-luxury" style="display: flex; align-items: center; gap: 16px;">
        <i class="bi bi-door-open" style="font-size: 1.5rem;"></i>
        <div>
            <div>Oda: <strong style="color: var(--white);">@ViewBag.OdaNumarasi</strong></div>
            <div>Gecelik: <strong style="color: var(--gold);">@ViewBag.GecelikFiyat.ToString("N0") ₺</strong></div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-luxury-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form asp-action="BookRoom" method="post" class="luxury-form">
        <input type="hidden" asp-for="RoomId" />
        <input type="hidden" asp-for="UserId" />

        <div class="row">
            <div class="col-md-6 mb-4">
                <label asp-for="GirisTarihi" class="form-label">Giriş Tarihi</label>
                <input asp-for="GirisTarihi" type="text" class="form-control" placeholder="Tarih seçin..." />
            </div>
            <div class="col-md-6 mb-4">
                <label asp-for="CikisTarihi" class="form-label">Çıkış Tarihi</label>
                <input asp-for="CikisTarihi" type="text" class="form-control" placeholder="Tarih seçin..." />
            </div>
        </div>

        <button type="submit" class="btn-gold"><i class="bi bi-check2-circle me-2"></i>Rezervasyonu Onayla</button>
        <a asp-controller="Home" asp-action="Index" class="btn-gold-outline" style="width: 100%; text-align: center; margin-top: 10px; display: block;">İptal</a>
    </form>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var tarihler = @Html.Raw(string.IsNullOrEmpty(ViewBag.DoluTarihler) ? "[]" : ViewBag.DoluTarihler);
            var disableDates = [];

            if (Array.isArray(tarihler)) {
                tarihler.forEach(function(item) {
                    if(item && item.Giris && item.Cikis) {
                        disableDates.push({ from: item.Giris.split('T')[0], to: item.Cikis.split('T')[0] });
                    }
                });
            }

            var fpOptions = {
                locale: "tr",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d F Y",
                minDate: "today",
                disable: disableDates,
                inline: true
            };

            flatpickr("#GirisTarihi", fpOptions);
            flatpickr("#CikisTarihi", fpOptions);
        });
    </script>
}
