@model IEnumerable<otelrezervation.DTOs.RoomDto>
@{
    ViewData["Title"] = "Ana Sayfa";
    
    // Oda resim havuzu — odalari sirayla farkli resimlerle eslestiriyoruz
    var roomImages = new[] { "/images/room-deluxe.png", "/images/room-suite.png", "/images/room-standard.png" };
    int imageIndex = 0;
}

<!-- ========== HERO SECTION ========== -->
<section class="hero-section">
    <div class="hero-content">
        <p class="hero-subtitle">Luxury Resort & SPA</p>
        <h1>Unutulmaz Bir Tatil<br/>Deneyimine Hoşgeldiniz</h1>
        <p class="hero-desc">Akdeniz'in eşsiz mavisinde lüks, konfor ve huzuru bir arada yaşayın.</p>
        <a href="#rooms" class="btn-gold">Odalarımızı Keşfedin</a>
    </div>
</section>

<!-- ========== OTEL ÖZELLİKLERİ ========== -->
<section class="section" style="background: var(--dark-soft);">
    <div class="container">
        <div class="section-title">
            <span class="overline">Ayrıcalıklar</span>
            <h2>Sizin İçin Sunduklarımız</h2>
            <div class="divider"></div>
        </div>
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-water"></i></div>
                    <h5>Infinity Havuz</h5>
                    <p>Deniz manzaralı açık ve kapalı yüzme havuzlarımızda serinleyin.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-flower1"></i></div>
                    <h5>SPA & Wellness</h5>
                    <p>Profesyonel terapistlerimizle kendinizi baştan yaratın.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-cup-hot"></i></div>
                    <h5>Fine Dining</h5>
                    <p>Ödüllü şeflerimizin hazırladığı dünya mutfağının tadını çıkarın.</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="feature-item">
                    <div class="feature-icon"><i class="bi bi-wifi"></i></div>
                    <h5>Ücretsiz Wi-Fi</h5>
                    <p>Tüm otel alanlarında yüksek hızlı internet erişimi.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ========== ODALAR (ANA VİTRİN) ========== -->
<section class="section" id="rooms">
    <div class="container">
        <div class="section-title">
            <span class="overline">Konaklama</span>
            <h2>Odalarımız & Süitler</h2>
            <p>Her biri özenle tasarlanmış odalarımızda lüksün ve konforun tadını çıkarın.</p>
            <div class="divider"></div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var room in Model)
                {
                    var currentImage = roomImages[imageIndex % roomImages.Length];
                    imageIndex++;

                    <div class="col-lg-4 col-md-6">
                        <div class="room-card">
                            <div class="room-image">
                                <img src="@currentImage" alt="Oda @room.OdaNumarasi" />
                                <div class="room-price">
                                    <span>@room.GecelikFiyat.ToString("N0") ₺</span>
                                    <small> / gece</small>
                                </div>
                            </div>
                            <div class="room-info">
                                <h4>Oda @room.OdaNumarasi</h4>

                                @if (User.Identity != null && User.Identity.IsAuthenticated)
                                {
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-controller="Reservation" asp-action="Create" asp-route-roomId="@room.Id" class="btn-gold-outline">
                                            Manuel Rezervasyon
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Customer" asp-action="BookRoom" asp-route-roomId="@room.Id" class="btn-gold-outline">
                                            Rezervasyon Yap
                                        </a>
                                    }
                                }
                                else
                                {
                                    <a asp-controller="Auth" asp-action="Login" class="btn-gold-outline">
                                        Rezervasyon İçin Giriş Yap
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center" style="padding: 60px 0;">
                    <i class="bi bi-building" style="font-size: 4rem; color: var(--gold); opacity: 0.4;"></i>
                    <p class="mt-3" style="color: var(--text-light); font-size: 1.1rem;">Şu an sistemimizde kayıtlı oda bulunmamaktadır.</p>
                </div>
            }
        </div>
    </div>
</section>
