@model IEnumerable<otelrezervation.DTOs.RoomDto>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mt-5 mb-5">
    <h1 class="display-4 fw-bold text-primary">Otelimize Hoşgeldiniz!</h1>
    <p class="lead text-muted">Lüks ve konforun buluştuğu eşsiz deneyimi yaşayın. Bütçenize uygun harika odalarımız aşağıda listelenmiştir.</p>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var room in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px; font-size: 3rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="bi bi-door-open"></i>
                    </div>
                    <div class="card-body text-center mt-3">
                        <h4 class="card-title fw-bold text-dark">Oda @room.OdaNumarasi</h4>
                        <h5 class="text-success fw-bold mb-4">@room.GecelikFiyat.ToString("C") <span class="text-muted" style="font-size:0.9rem;">/ Gece</span></h5>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-controller="Reservation" asp-action="Create" asp-route-roomId="@room.Id" class="btn btn-dark px-4 fw-bold rounded-pill shadow-sm w-100 py-2">
                                    Manuel Rezervasyon (Admin)
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Customer" asp-action="BookRoom" asp-route-roomId="@room.Id" class="btn btn-primary px-4 fw-bold rounded-pill shadow-sm w-100 py-2">
                                    Hemen Rezervasyon Yap
                                </a>
                            }
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary px-4 fw-bold rounded-pill w-100 py-2">
                                Rezervasyon İçin Giriş Yap
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-muted">
            <i class="bi bi-emoji-frown display-1"></i>
            <p class="mt-3 fs-5">Şu an sistemimizde kayıtlı hiçbir oda bulunamadı.</p>
        </div>
    }
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
