<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lumina Admin</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    
    <style>
        :root {
            --gold: #C2A676;
            --gold-light: #D4C4A0;
            --dark: #1A1A1A;
            --dark-soft: #2C2C2C;
        }

        body {
            background-color: #f4f2ef;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            min-height: 100vh;
        }

        /* ===== TOP NAVBAR ===== */
        .admin-topbar {
            background-color: var(--dark);
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 1050;
            box-shadow: 0 2px 15px rgba(0,0,0,0.3);
        }

        .admin-topbar .navbar-brand {
            font-family: 'Playfair Display', serif;
            color: var(--gold) !important;
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: 3px;
            padding: 14px 24px;
        }

        .admin-topbar .nav-link {
            color: #adb5bd !important;
            font-size: 0.82rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            padding: 16px 18px !important;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .admin-topbar .nav-link:hover {
            color: #fff !important;
            background-color: rgba(255,255,255,0.05);
            border-bottom-color: var(--gold);
        }

        .admin-topbar .nav-link.active {
            color: var(--gold) !important;
            border-bottom-color: var(--gold);
            background-color: rgba(194, 166, 118, 0.08);
        }

        .admin-topbar .nav-link i {
            color: var(--gold);
        }

        .admin-user-info {
            color: #adb5bd;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px;
        }

        .admin-user-info .badge {
            background-color: var(--gold) !important;
            color: var(--dark);
            font-weight: 600;
            font-size: 0.65rem;
            letter-spacing: 1px;
        }

        .btn-admin-logout {
            color: #dc3545 !important;
            font-size: 0.78rem;
            padding: 6px 14px !important;
            border: 1px solid rgba(220,53,69,0.3);
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .btn-admin-logout:hover {
            background-color: rgba(220,53,69,0.1);
            border-color: #dc3545;
        }

        .btn-site-link {
            color: var(--gold) !important;
            font-size: 0.78rem;
            padding: 6px 14px !important;
            border: 1px solid rgba(194,166,118,0.3);
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .btn-site-link:hover {
            background-color: rgba(194,166,118,0.1);
            border-color: var(--gold);
        }

        /* ===== PAGE HEADER ===== */
        .page-header {
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-soft) 100%);
            padding: 28px 0;
            border-bottom: 3px solid var(--gold);
        }

        .page-header h2 {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 1.5rem;
            font-weight: 500;
            margin: 0;
        }

        .page-header .breadcrumb-text {
            color: var(--gold);
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 500;
        }

        /* ===== CONTENT AREA ===== */
        .admin-content {
            padding: 30px 0;
            min-height: calc(100vh - 160px);
        }

        /* ===== TABLE STYLING (TUM ADMIN SAYFALARI ICIN) ===== */
        .admin-content .table thead {
            background-color: var(--dark) !important;
        }

        .admin-content .table thead th {
            color: var(--gold) !important;
            font-weight: 600;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
            border: none;
            padding: 14px 16px;
        }

        .admin-content .table tbody td {
            vertical-align: middle;
            padding: 12px 16px;
            font-size: 0.88rem;
        }

        .admin-content .table tbody tr:hover {
            background-color: rgba(194, 166, 118, 0.05);
        }

        /* ===== CARD STYLING ===== */
        .admin-content .card {
            border: none;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }

        /* ===== BUTTONS ===== */
        .btn-gold {
            background-color: var(--gold);
            color: #fff;
            border: none;
            font-weight: 600;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
            padding: 8px 20px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .btn-gold:hover {
            background-color: #A68B5B;
            color: #fff;
        }

        .btn-gold-outline {
            border: 1px solid var(--gold);
            color: var(--gold);
            background: transparent;
            font-weight: 500;
            font-size: 0.82rem;
            padding: 8px 20px;
            border-radius: 4px;
            transition: all 0.3s ease;
        }

        .btn-gold-outline:hover {
            background-color: var(--gold);
            color: #fff;
        }

        /* ===== ADMIN FOOTER ===== */
        .admin-footer {
            background-color: var(--dark);
            color: #666;
            text-align: center;
            padding: 16px 0;
            font-size: 0.75rem;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="admin-topbar navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Admin"><i class="bi bi-shield-lock me-2"></i>LUMINA</a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" href="/Admin">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reservation" ? "active" : "")" href="/Reservation">
                                <i class="bi bi-calendar-check me-1"></i> Rezervasyonlar
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Room" ? "active" : "")" href="/Room">
                                <i class="bi bi-door-open me-1"></i> Odalar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "active" : "")" href="/User">
                                <i class="bi bi-person-lines-fill me-1"></i> Müşteriler
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "UserManagement" ? "active" : "")" href="/UserManagement">
                                <i class="bi bi-people me-1"></i> Personel
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Contact" && ViewContext.RouteData.Values["Action"]?.ToString() == "Messages" ? "active" : "")" href="/Contact/Messages">
                                <i class="bi bi-envelope me-1"></i> Mesajlar
                            </a>
                        </li>
                    }
                    @if (User.IsInRole("Admin") || User.IsInRole("Marketing"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SiteSettings" ? "active" : "")" href="/SiteSettings/PageManager">
                                <i class="bi bi-window-sidebar me-1"></i> Sayfa Yönetimi
                            </a>
                        </li>
                    }
                </ul>

                <!-- Sağ taraf: Kullanıcı bilgisi + Butonlar -->
                <div class="d-flex align-items-center gap-3">
                    <div class="admin-user-info d-none d-lg-flex">
                        <i class="bi bi-person-circle" style="color: var(--gold); font-size: 1.2rem;"></i>
                        <span>@User.Identity?.Name</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge">ADMIN</span>
                        }
                        else if (User.IsInRole("Marketing"))
                        {
                            <span class="badge">PAZARLAMA</span>
                        }
                        else if (User.IsInRole("Receptionist"))
                        {
                            <span class="badge">RESEPSİYONİST</span>
                        }
                    </div>
                    <a asp-controller="Home" asp-action="Konaklama" target="_blank" class="nav-link btn-site-link" style="border-color: #6c757d; color: #adb5bd !important;"><i class="bi bi-eye me-1"></i> Müşteri Gözünden Gör</a>
                    <a href="/" class="nav-link btn-site-link"><i class="bi bi-globe me-1"></i> Siteye Dön</a>
                    <a href="/Auth/Logout" class="nav-link btn-admin-logout"><i class="bi bi-box-arrow-left me-1"></i> Çıkış</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="container">
            <span class="breadcrumb-text">Yönetim Paneli</span>
            <h2>@ViewData["Title"]</h2>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="admin-content">
        <div class="container">
            @RenderBody()
        </div>
    </div>

    <!-- FOOTER -->
    <div class="admin-footer">
        &copy; 2026 Lumina Resort & SPA — Yönetim Paneli
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
