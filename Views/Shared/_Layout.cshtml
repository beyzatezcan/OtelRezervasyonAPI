<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Lumina Resort & SPA</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Luxury Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="luxury-navbar navbar navbar-expand-lg" id="mainNavbar">
        <div class="container">
            <a class="navbar-brand" href="/">LUMINA</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Ana Sayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Blog" asp-action="Index">Blog</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Contact" asp-action="Index">İletişim</a>
                    </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Customer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="MyReservations">Rezervasyonlarım</a>
                        </li>
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="User" asp-action="Index">Müşteriler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Room" asp-action="Index">Odalar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reservation" asp-action="Index">Rezervasyonlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/swagger">API</a>
                        </li>
                    }
                </ul>

                <!-- Auth Buttons -->
                <div class="d-flex ms-lg-4 align-items-center gap-2 mt-3 mt-lg-0">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span style="color: var(--gold); font-size: 0.85rem; letter-spacing: 1px;">
                            <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                        </span>
                        <a asp-controller="Auth" asp-action="Logout" class="btn-gold-outline" style="padding: 6px 18px; font-size: 0.7rem;">
                            Çıkış
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn-gold-outline" style="padding: 8px 20px; font-size: 0.7rem;">
                            Giriş Yap
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="btn-gold" style="padding: 8px 20px; font-size: 0.7rem;">
                            Kayıt Ol
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- İçerik Alanı -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="luxury-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-brand">LUMINA</div>
                    <p>Akdeniz kıyısında lüks ve huzurun buluştuğu eşsiz bir tatil deneyimi. Misafirlerimize unutulmaz anlar yaşatmayı hedefliyoruz.</p>
                </div>
                <div class="col-lg-2 col-md-4">
                    <div class="footer-heading">Keşfet</div>
                    <ul class="footer-links">
                        <li><a href="/">Ana Sayfa</a></li>
                        <li><a href="#">Odalar</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="footer-heading">İletişim</div>
                    <ul class="footer-links">
                        <li><i class="bi bi-geo-alt me-2" style="color: var(--gold);"></i> Konyaaltı, Antalya</li>
                        <li><i class="bi bi-telephone me-2" style="color: var(--gold);"></i> +90 242 000 00 00</li>
                        <li><i class="bi bi-envelope me-2" style="color: var(--gold);"></i> info@luminaresort.com</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="footer-heading">Bizi Takip Edin</div>
                    <div class="d-flex gap-3 mt-2">
                        <a href="#" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a href="#" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                            <i class="bi bi-youtube"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Lumina Resort & SPA — Tüm Hakları Saklıdır.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Navbar Scroll Effect -->
    <script>
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('mainNavbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
