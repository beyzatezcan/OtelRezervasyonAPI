@inject otelrezervation.Services.ISiteSettingService SiteSettings
@{
    var phone = SiteSettings.GetValue("Contact_Phone", "+90 242 000 00 00");
    var email = SiteSettings.GetValue("Contact_Email", "info@luminaresort.com");
    var address = SiteSettings.GetValue("Contact_Address", "Konyaaltı, Antalya");
    var footerAbout = SiteSettings.GetValue("Footer_About", "Akdeniz kıyısında lüks ve huzurun buluştuğu eşsiz bir tatil deneyimi. Misafirlerimize unutulmaz anlar yaşatmayı hedefliyoruz.");
    
    var instagram = SiteSettings.GetValue("Social_Instagram", "#");
    var facebook = SiteSettings.GetValue("Social_Facebook", "#");
    var twitter = SiteSettings.GetValue("Social_Twitter", "#");
    var youtube = SiteSettings.GetValue("Social_Youtube", "#");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Lumina Resort & SPA</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Luxury Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="luxury-navbar navbar navbar-expand-lg" id="mainNavbar">
        <div class="container">
            <a class="navbar-brand" href="/">LUMINA</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Ana Sayfa</a>
                    </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Konaklama">Konaklama</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Blog" asp-action="Index">Haberler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">İletişim</a>
                        </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Customer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Customer" asp-action="MyReservations">Rezervasyonlarım</a>
                        </li>
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Receptionist") || User.IsInRole("Marketing")))
                    {
                        string adminUrl = User.IsInRole("Marketing") && !User.IsInRole("Admin") ? "/SiteSettings/PageManager" : "/Admin";
                        <li class="nav-item ms-3">
                            <a class="nav-link" style="font-weight: bold; border: 1px solid; border-radius: 5px; padding: 8px 15px;" href="@adminUrl">Yönetim Paneli</a>
                        </li>
                    }
                </ul>

                <!-- Auth Buttons -->
                <div class="d-flex ms-lg-4 align-items-center gap-2 mt-3 mt-lg-0">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="color: var(--gold) !important; font-size: 0.85rem; letter-spacing: 1px;">
                                <div><i class="bi bi-person-circle me-1"></i> @User.Identity.Name</div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge" style="background-color: var(--gold); color: var(--dark); font-size: 0.65rem; letter-spacing: 1px;">ADMIN</span>
                                }
                                else if (User.IsInRole("Receptionist"))
                                {
                                    <span class="badge" style="background-color: var(--gold); color: var(--dark); font-size: 0.65rem; letter-spacing: 1px;">RESEPSİYONİST</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark" aria-labelledby="userDropdown" style="background-color: var(--dark); border: 1px solid rgba(194,166,118,0.2);">
                                <li><a class="dropdown-item" href="/Customer/Profile"><i class="bi bi-person-gear me-2 text-muted"></i> Profilim</a></li>
                                <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/Auth/Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> ÇIKIŞ
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn-gold-outline" style="padding: 8px 20px; font-size: 0.7rem;">
                            Giriş Yap
                        </a>
                        <a asp-controller="Auth" asp-action="Register" class="btn-gold" style="padding: 8px 20px; font-size: 0.7rem;">
                            Kayıt Ol
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- İçerik Alanı -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="luxury-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-brand">LUMINA</div>
                    <p>@footerAbout</p>
                </div>
                <div class="col-lg-2 col-md-4">
                    <div class="footer-heading">Keşfet</div>
                    <ul class="footer-links">
                        <li><a href="/">Ana Sayfa</a></li>
                        <li><a href="/Home/Konaklama">Konaklama</a></li>
                        <li><a href="/Blog">Haberler</a></li>
                        <li><a href="/Contact">İletişim</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="footer-heading">İletişim</div>
                    <ul class="footer-links">
                        <li><i class="bi bi-geo-alt me-2" style="color: var(--gold);"></i> @address</li>
                        <li><i class="bi bi-telephone me-2" style="color: var(--gold);"></i> @phone</li>
                        <li><i class="bi bi-envelope me-2" style="color: var(--gold);"></i> @email</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-4">
                    <div class="footer-heading">Bizi Takip Edin</div>
                    <div class="d-flex gap-3 mt-2">
                        @if (instagram != "hidden")
                        {
                            <a href="@instagram" target="_blank" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                                <i class="bi bi-instagram"></i>
                            </a>
                        }
                        @if (facebook != "hidden")
                        {
                            <a href="@facebook" target="_blank" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                                <i class="bi bi-facebook"></i>
                            </a>
                        }
                        @if (twitter != "hidden")
                        {
                            <a href="@twitter" target="_blank" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                                <i class="bi bi-twitter-x"></i>
                            </a>
                        }
                        @if (youtube != "hidden")
                        {
                            <a href="@youtube" target="_blank" style="color: var(--text-light); font-size: 1.3rem; transition: var(--transition);">
                                <i class="bi bi-youtube"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Lumina Resort & SPA — Tüm Hakları Saklıdır.</p>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Navbar Scroll Effect -->
    <script>
        window.addEventListener('scroll', function() {
            const navbar = document.getElementById('mainNavbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
